generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  /// Late by hand, as opposed to the lateness a passed due date implies. See
  /// TaskStatus in the shared package for why both exist.
  OVERDUE
}

enum RoutineRecurrence {
  WEEKLY
  MONTHLY
}

/// Where a calendar account's agendas come from. See CalendarProvider in the
/// shared package.
enum CalendarProvider {
  GLOO
  GOOGLE
}

/// What a row on the calendar actually is.
///
/// EVENT is everything the app itself creates and everything Google sends
/// through the Calendar API. TASK is a Google *task* — a different product with
/// a different API, mirrored onto the grid so a day reads as one day rather than
/// as two lists side by side; it is the only kind that can be ticked off.
/// APPOINTMENT is a slot booked through an appointment schedule, which Google
/// marks with its own `eventType`.
enum CalendarItemKind {
  EVENT
  TASK
  APPOINTMENT
}

/// How a recurring event repeats. Four fixed rules rather than a general RRULE
/// — see EventRecurrence in the shared package for why, and for what happens
/// to a Google event whose rule is something else.
enum EventRecurrence {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  /// Permission level. Not user-editable — see `jobTitle` for the display one.
  role         Role     @default(EMPLOYEE)
  /// Free-text job title shown under the user's name ("Designer"). Purely
  /// cosmetic: it carries no authorization meaning, which is why the user is
  /// allowed to edit their own.
  jobTitle     String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdTasks     Task[]            @relation("TaskCreator")
  assignedTasks    TaskAssignee[]
  createdRoutines  Routine[]         @relation("RoutineCreator")
  assignedRoutines RoutineAssignee[]

  calendarAccounts CalendarAccount[]
  agendas          Agenda[]
  createdEvents    CalendarEvent[]         @relation("CalendarEventCreator")
  assignedEvents   CalendarEventAssignee[]
  oauthStates      GoogleOAuthState[]

  @@map("users")
}

model Sector {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  tasks Task[]

  @@map("sectors")
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  status      TaskStatus   @default(TODO)
  sectorId    String
  sector      Sector       @relation(fields: [sectorId], references: [id])
  createdById String
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  /// Links and uploaded files, as `[{ id, kind, url, title }]` — the same shape
  /// and the same reasoning as a routine's, so both read through the one parser
  /// in the routines mapper. The files themselves live in UPLOADS_DIR.
  attachments Json?

  /// How long the task has spent in IN_PROGRESS, in milliseconds — the raw
  /// material for the productivity chart on the Tasks page.
  ///
  /// Three columns rather than one, because a task can be started, stopped and
  /// started again: `workedMs` is what previous stretches added up to,
  /// `startedAt` marks the one currently running (null when none is), and the
  /// live total is `workedMs` plus the time since `startedAt`. Only the status
  /// route writes them — see the transitions there.
  workedMs    Int          @default(0)
  startedAt   DateTime?
  /// When the task last reached DONE. Cleared if it is reopened, so it always
  /// pairs with the status rather than remembering a completion that was undone.
  completedAt DateTime?

  subtasks  Subtask[]
  assignees TaskAssignee[]
  labels    TaskLabel[]

  @@index([status])
  @@index([dueDate])
  @@index([sectorId])
  @@map("tasks")
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_assignees")
}

model Subtask {
  id     String  @id @default(uuid())
  taskId String
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text   String
  done   Boolean @default(false)
  order  Int     @default(0)

  @@index([taskId])
  @@map("subtasks")
}

model Routine {
  id              String            @id @default(uuid())
  /// Shown as "Título" in the UI; kept as `description` because it is the
  /// routine's only text and every consumer already reads it by that name.
  description     String
  recurrence      RoutineRecurrence
  /// The single weekday a weekly routine falls on, 0=Sunday … 6=Saturday.
  ///
  /// Still the common case, and still what a routine picked from the plain list
  /// stores. A routine set to repeat on several days keeps its earliest day here
  /// too, so anything that only knows how to ask "which day?" — an old client, a
  /// query, a report — gets an answer that is true rather than null.
  weekday         Int?
  /// Every weekday a weekly routine repeats on, when the user chose more than
  /// one. Empty for a routine that falls on a single day, which is what makes
  /// `weekday` alone enough to describe it.
  ///
  /// A Postgres array rather than a bitmask or a join table: there are seven
  /// possible values, they are read as a set and written as a set, and nothing
  /// ever queries by one of them.
  weekdays        Int[]             @default([])
  dayOfMonth      Int?
  /// Free-text annotation shown in the routine's edit modal.
  notes           String?
  /// Up to five checklists, as `[{ title, items: [{ text, done }] }]`.
  /// Embedded rather than its own table (unlike Task/Subtask): they belong to
  /// one routine, are never queried or filtered on, and save in the routine's
  /// own PATCH — a join table would buy nothing here.
  checklists      Json?
  /// Links and uploaded files, as `[{ id, kind, url, title }]`. Embedded for
  /// the same reasons as `checklist`; the files themselves live in UPLOADS_DIR.
  attachments     Json?
  done            Boolean           @default(false)
  lastCompletedAt DateTime?
  /// When the routine was moved to the trash. Null for a live one.
  ///
  /// Deleting is reversible from the Routines card, so "Deletar" sets this and
  /// the row stays put — only "Esvaziar lixeira" actually removes it. Every
  /// query for live routines has to filter on it.
  deletedAt       DateTime?
  createdById     String
  createdBy       User              @relation("RoutineCreator", fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  assignees RoutineAssignee[]
  labels    RoutineLabel[]

  @@map("routines")
}

/// Routines carry multiple assignees, exactly like tasks.
model RoutineAssignee {
  routineId String
  userId    String
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([routineId, userId])
  @@map("routine_assignees")
}

/// User-defined tag. Shared across the routines (or the tasks) that wear it —
/// the picker lists every label in its own pool so they can be reused — but
/// never across the two: see `scope`.
model Label {
  id        String   @id @default(uuid())
  name      String
  /// A key into the `--label-*` palette in globals.css, or a `#rrggbb` the user
  /// mixed — see PaletteColor in the shared package, which validates both.
  color     String
  /// Which pool this tag belongs to: "ROUTINE" or "TASK".
  ///
  /// The two are separate vocabularies that happen to look alike. A routine's
  /// tags describe recurring work ("gestão interna"), a task's describe a piece
  /// of it — and mixing them meant renaming one in a task quietly renamed it on
  /// somebody's routine. Every query for the picker filters on this, so a label
  /// created on one side is invisible on the other.
  ///
  /// A string rather than a Postgres enum: the set is closed but tiny, and the
  /// shared package already validates it the way it validates colours.
  scope     String   @default("ROUTINE")
  createdAt DateTime @default(now())

  routines RoutineLabel[]
  tasks    TaskLabel[]

  @@index([scope])
  @@map("labels")
}

/// The same tag on a task. A join table of its own rather than one shared with
/// routines: the two owners are different tables, and a single table would need
/// a nullable column per owner and a check constraint to keep them exclusive.
model TaskLabel {
  taskId  String
  labelId String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

model RoutineLabel {
  routineId String
  labelId   String
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  label     Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([routineId, labelId])
  @@map("routine_labels")
}

/// A source of agendas: the built-in Gloo one, or a linked Google account.
///
/// Always personal, unlike sectors and labels. The Google tokens on one are a
/// single user's, and the Gloo account is where that user's own agendas live —
/// which is why every query below starts from `userId` rather than from the
/// event.
model CalendarAccount {
  id       String           @id @default(uuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider CalendarProvider

  /// What the group is called in the Agendas card. Seeded from the Google
  /// address on link, then the user's to rename.
  displayName String
  /// Whether the group is folded shut. Stored rather than kept in component
  /// state so the card looks the same after a reload.
  isCollapsed Boolean @default(false)

  /// Google's stable user id — the one thing about an account that never
  /// changes, so relinking the same account updates it instead of adding a
  /// duplicate row. Null on the Gloo account.
  googleSub   String?
  googleEmail String?

  /// OAuth tokens, AES-256-GCM ciphertext — never the raw values. See
  /// lib/tokenCrypto.ts; the key lives in GOOGLE_TOKEN_KEY.
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  /// What Google actually granted, which can be less than we asked for. Checked
  /// before any call that needs a scope the user may have unticked.
  grantedScope   String?

  /// Set when Google stops accepting our refresh token — revoked access, or the
  /// 7-day expiry that applies while the consent screen is unverified. The card
  /// offers "Reconectar" rather than showing stale agendas as if they were live.
  needsReauth Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agendas Agenda[]

  /// One row per Google account per user. Partial in effect: the Gloo account
  /// has a null googleSub, and Postgres treats nulls as distinct, so this does
  /// not stop a user having exactly one Gloo account — the service layer does.
  @@unique([userId, provider, googleSub])
  @@index([userId])
  @@map("calendar_accounts")
}

/// One calendar in the list: a Gloo-local agenda, or a mirror of a Google one.
model Agenda {
  id        String          @id @default(uuid())
  accountId String
  account   CalendarAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// The owner, denormalised off the account so listing a user's agendas — the
  /// most common query here — doesn't have to join through it.
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  /// A key into the `--label-*` palette, never a hex — as with a Label. Google's
  /// own colours don't belong to our design system, so an imported calendar is
  /// assigned one from ours and the user can change it after.
  color String

  /// Hidden by the eye icon: the agenda stays in the list, its events leave the
  /// grid. Per user by construction, since the agenda itself is.
  isHidden  Boolean @default(false)
  /// Where a new event lands when the user doesn't pick an agenda. The service
  /// layer keeps exactly one true per user.
  isDefault Boolean @default(false)
  /// A Google calendar we may read but not write — a subscribed holiday feed,
  /// or one shared at reader access. Its events can't be dragged or edited.
  isReadOnly Boolean @default(false)
  sortOrder  Int     @default(0)

  /// The row that collects events somebody else assigned to this user.
  ///
  /// Agendas are personal, so an event created on a colleague's agenda has no
  /// agenda of *mine* to hang under — but it still has to appear, be hidden by
  /// an eye icon, and take a colour. A real row rather than something the API
  /// invents per request, so those two settings persist like any other
  /// agenda's. Nothing is ever stored *on* it: events keep living on their
  /// creator's agenda and are only displayed here.
  ///
  /// One per user, provisioned alongside the default. Cannot be renamed,
  /// deleted, or made the default.
  isSharedInbox Boolean @default(false)

  /// The calendar's id on Google's side. Null for a Gloo-local agenda.
  googleCalendarId String?

  /// The *task list's* id on Google's side, for the agenda that mirrors one.
  ///
  /// A task list is not a calendar — different API, different ids — but it is
  /// the same thing to a reader: a named bucket of dated items with a colour.
  /// Modelling it as an agenda is what lets the grid, the day summary, the
  /// dot colours and the visibility filter all work on it unchanged.
  googleTaskListId String?
  /// Google's incremental sync cursor for this calendar. Null until the first
  /// full sync completes; the token preserves that first request's time bounds.
  googleSyncToken  String?

  /// When the user removed the calendar from the list.
  ///
  /// A flag rather than a delete, because the next import would otherwise walk
  /// straight back in and re-add it. Removing never touches anything in Google
  /// — the user re-adds it from their Google settings, which is what the
  /// confirmation says.
  removedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CalendarEvent[]

  @@unique([accountId, googleCalendarId])
  @@unique([accountId, googleTaskListId])
  @@index([userId])
  @@map("agendas")
}

/// An event, or an edited occurrence of a recurring one.
///
/// Both are the same table on purpose: this is exactly Google's shape, where an
/// instance exception *is* an event resource carrying `recurringEventId` and
/// `originalStartTime`. A narrow override table would have to duplicate every
/// column an exception can differ in — including its assignees — and would
/// still need translating on the way to Google.
model CalendarEvent {
  id          String @id @default(uuid())
  agendaId    String
  agenda      Agenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation("CalendarEventCreator", fields: [createdById], references: [id])

  title String
  /// Rich text, sanitised on the way in like a task's notes.
  description String?
  /// A place or, more usually here, a meeting link.
  location    String?

  /// Absolute instants. `timeZone` is what says how to label them — an event
  /// keeps the wall clock of the zone it was created in, so a series doesn't
  /// slide when its owner travels or when the clocks change.
  startsAt DateTime
  endsAt   DateTime
  isAllDay Boolean  @default(false)
  timeZone String

  /// Set on the MASTER row of a series only. An exception inherits the rule
  /// from its master and carries neither of these.
  recurrence      EventRecurrence?
  /// The last instant an occurrence may start on, inclusive. Stored as the end
  /// of the chosen day in the event's own zone — see endOfDayInZone.
  ///
  /// Null means the series never ends. Google's UI produces open-ended events
  /// by default and four of the six calendars linked in testing had them, so
  /// this is the common case rather than an edge one; expansion bounds an
  /// endless series by the window being drawn.
  recurrenceUntil DateTime?

  /// Which weekdays a weekly series lands on, as 0=Sunday … 6=Saturday.
  ///
  /// Empty means "the same weekday the series started on", which is what our
  /// own event modal produced before this existed. Google emits BYDAY on every
  /// weekly event it creates — including single-day ones — so without this the
  /// entire real-world corpus of recurring events failed to import as
  /// recurring. Only meaningful for WEEKLY and BIWEEKLY.
  byWeekdays Int[] @default([])

  /// The master this row overrides, and which of its slots. Both null on a
  /// one-off event and on a master.
  recurringEventId String?
  recurringEvent   CalendarEvent?  @relation("EventExceptions", fields: [recurringEventId], references: [id], onDelete: Cascade)
  exceptions       CalendarEvent[] @relation("EventExceptions")
  originalStart    DateTime?
  /// True when the user deleted this one occurrence. The row stays so expansion
  /// keeps skipping the slot, and so the deletion can be pushed to Google.
  isCancelled      Boolean         @default(false)

  /// What this row is — see CalendarItemKind. Everything the app creates is an
  /// EVENT; the other two only ever arrive from Google.
  kind CalendarItemKind @default(EVENT)

  /// Whether a TASK has been ticked off. Meaningless on the other two kinds,
  /// which is why it is a plain flag rather than a status: an event is not a
  /// thing you complete.
  isDone Boolean @default(false)

  /// The mirror on Google's *Tasks* side, for a row whose kind is TASK. The list
  /// id is needed to write back: the Tasks API addresses a task as
  /// list + task, and there is no lookup by task id alone.
  googleTaskId     String?
  googleTaskListId String?

  /// The `due` date this task last arrived from Google with.
  ///
  /// What tells a task the user moved here from a task Google moved. The Tasks
  /// API has no field for an hour — its `due` is a date, and the time is
  /// discarded — so the hour on the grid is ours and only ours, and a plain
  /// comparison against `due` would drag every scheduled task back to midnight
  /// on the next sync. Kept, so an unchanged `due` means "Google has nothing new
  /// to say about when this is" and the local time stands.
  googleTaskDue DateTime?

  /// The mirror on Google's side. `googleEtag` is what the conflict check sends
  /// as If-Match; `googleICalUid` is what identifies the same event across
  /// calendars when it was invited rather than created.
  googleEventId String?
  googleICalUid String?
  googleEtag    String?
  lastSyncedAt  DateTime?

  /// Attendees Google knows about that have no Gloo user to match — external
  /// guests, as `["ana@fora.com"]`. Kept so a round-trip doesn't drop them off
  /// the invitation.
  externalAttendees Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignees CalendarEventAssignee[]

  /// One override per slot. Also what makes importing the same Google exception
  /// twice a no-op rather than a duplicate.
  @@unique([recurringEventId, originalStart])
  @@index([agendaId, startsAt])
  @@index([startsAt])
  @@map("calendar_events")
}

/// Events carry multiple assignees, exactly like tasks and routines.
///
/// Also the read rule: an event is visible to whoever created it and to anyone
/// assigned to it, which is what lets an agenda stay personal while the event
/// on it is shared with the people it concerns.
model CalendarEventAssignee {
  eventId String
  userId  String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("calendar_event_assignees")
}

/// One in-flight OAuth authorisation.
///
/// Server-side rather than in a cookie because the row is what binds the code
/// coming back from Google to the user who started the flow — the callback is a
/// public route and must not take an identity from its own query string. It is
/// deleted the moment it is looked up, which is what makes a replayed callback
/// URL fail.
model GoogleOAuthState {
  state        String   @id
  /// The PKCE verifier whose challenge went to Google. Never leaves the server.
  codeVerifier String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
  @@map("google_oauth_states")
}
