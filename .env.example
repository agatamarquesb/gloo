POSTGRES_USER=gloo
POSTGRES_PASSWORD=gloo_dev_password
POSTGRES_DB=gloo

# Used by Prisma inside the api container (matches the postgres service above)
DATABASE_URL=postgresql://gloo:gloo_dev_password@postgres:5432/gloo

JWT_SECRET=change_me_to_a_long_random_string

VITE_API_URL=http://localhost:3001

GOOGLE_CLIENT_ID=<the client ID>
GOOGLE_CLIENT_SECRET=<the client secret>
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/google/callback
GOOGLE_TOKEN_KEY=<32 random bytes, base64>

# Credentials for `pnpm screenshot` (this file is gitignored)
GLOO_EMAIL=<your-email-here>
GLOO_PASSWORD=<your-password-here>
